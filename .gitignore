.env
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
dist/
build/
*.egg-info/
logs/
data/chroma/
data/.tmp_chroma*/
data/document_store.json
data/raw/

# Eval distractors are pure derivation: regenerate with scripts/build_eval_corpus.py
# (pinned dataset revisions + SEED=42 make it byte-identical). Gold/queries ARE committed.
data/eval/xquad/distractors_*.jsonl
data/eval/indic/distractors_*.jsonl

# Throwaway measurement spikes (M0, Indic, ...): built, measured, deleted. Never committed —
# the graduated report lives in docs/. This is a safety net against accidental 60MB commits.
spikes/

# Personal working notes (interview prep) — kept locally alongside the code they
# reference, but not part of the project. PDFs are rendered from the markdown.
decision.md
flow.md
decision.pdf
flow.pdf

# Rendered copy of docs/architecture.md (the markdown is the source of truth and IS committed).
architecture.pdf

# OS / editor cruft
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp
*.swo

# Local env overrides. Bare `.env` was not enough: a `.env.local` or `.env.production` holding a
# real GENERATION_API_KEY would have been committed. `.env.example` is the deliberate exception —
# it is the documented template and carries no secrets.
.env.*
!.env.example

# Machine-local Claude Code settings. Previously ignored only by a *global* gitignore on the
# original dev machine, so a fresh clone or a CI checkout would have offered it up as untracked.
# `.claude/` itself stays trackable — only this file is machine-specific.
.claude/settings.local.json

# Alternate virtualenv names, so a clone that runs `python -m venv venv` (rather than `.venv`)
# doesn't stage a few hundred MB of site-packages.
venv/
env/
ENV/
.python-version

# Packaging and test-runner leftovers not covered by the caches above.
.eggs/
*.egg
pip-wheel-metadata/
.tox/
.nox/
.hypothesis/
.coverage.*
coverage.xml
junit*.xml

# Local service state, for running Postgres/Redis/Celery outside docker compose.
dump.rdb
celerybeat-schedule*
celerybeat.pid

# Merge and patch leftovers — the easiest thing to commit by accident during a conflict.
*.orig
*.rej
*.bak
*~
